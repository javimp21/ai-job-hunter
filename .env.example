# PostgreSQL connection used by the application and Alembic.
DATABASE_URL=postgresql+psycopg://ai_job_hunter:ai_job_hunter@localhost:5432/ai_job_hunter
TYPESAFE_API_KEY=

# Optional Telegram opportunity notifications. Keep credentials only in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_REVIEW_MIN_PRIORITY=70

# Job portals queried by refresh/run (comma-separated; default: himalayas).
# Available: himalayas, adzuna, remoteok, remotive, jobicy, arbeitnow, fourdayweek, weworkremotely
# JOB_PORTALS=himalayas,manfred,remotive,jobicy,adzuna,arbeitnow,fourdayweek,weworkremotely
# Adzuna API credentials (free at https://developer.adzuna.com); the adzuna portal is skipped when blank.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# TheirStack API key (https://app.theirstack.com, API Keys). Add `theirstack` to JOB_PORTALS to enable it; one credit per job.
THEIRSTACK_API_KEY=
THEIRSTACK_DAILY_CREDITS=100
# Employers always searched on TheirStack in any country, comma-separated (e.g. Bizneo HR).
# THEIRSTACK_WATCH_COMPANIES=
# Candidate time zone (IANA name): decides the day of the Company Hunter queue. Default Europe/Madrid.
# SCHEDULE_TIMEZONE=Europe/Madrid
# TheirStack search filters, comma-separated (empty keeps the built-in defaults).
# THEIRSTACK_COUNTRIES=ES,NL,CH
# THEIRSTACK_TITLES=backend engineer,software engineer
# THEIRSTACK_SENIORITY=junior,mid_level
# Company boards read at the same time during a refresh (per-server limits still apply). 1 = one at a time.
# FETCH_WORKERS=8
