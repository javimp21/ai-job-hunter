[Unit]
Description=AI Job Hunter daily PostgreSQL backup (newest 14 kept)
After=postgresql.service
OnFailure=ai-job-hunter-notify-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-job-hunter/shared
ExecStart=/opt/ai-job-hunter/current/deploy/linux/backup-db.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
