[Unit]
Description=AI Job Hunter run: every 15 min 07:00-23:45 and hourly 00:00-06:00 (Europe/Madrid)

[Timer]
# Daytime: :00 :15 :30 :45 from 07 to 23. Night: on the hour from 00 to 06.
OnCalendar=*-*-* 07..23:00,15,30,45:00 Europe/Madrid
OnCalendar=*-*-* 00..06:00:00 Europe/Madrid
Persistent=true
Unit=ai-job-hunter-run.service

[Install]
WantedBy=timers.target
