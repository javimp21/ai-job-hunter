  "payroll_compound": "lohn(?:buch|abrech)|entgelt|salarisadmin|gestionnaire\\s+de\\s+paie|n[oó]minas?\\b",
  "treasury_compound": "tr[eé]sor|tesorer|tesour|liquidit[aä]t",
  "audit_compound": "\\baudit|pr[uü]fung|revisi[oó]n|commissaire\\s+aux\\s+comptes|wirtschaftspr",
  "procurement_compound": "einkauf|inkoop|\\bachats?\\b|\\bcompras\\b|aprovision|abastecimiento|procurement|purchasing",
  "credit_compound": "\\bkredit(?!oren)|credit(?:o|\\b)|\\brisk|riesg|risque|risico|risiko|rischio|\\brisco",
  "controlling_compound": "controll|contr[oô]le(?:ur)?\\s+(?:de\\s+)?gestion|control\\s+de\\s+gesti[oó]n",
  "consolidation_compound": "consolid|konsolid|konzernrechnung|konzernabschluss",
  "bank_ops": "\\bkyc\\b|\\bkyb\\b|\\baml\\b|sanction|wertpapier|middle\\s*office|back\\s*office\\s+(?:financ|titres|valeurs|bancari|valores)|fund\\s+(?:admin|operations)|securities|settlement|transfer\\s+agen|trading\\s+operations|financial\\s+operations|banking\\s+operations|investment\\s+data|financial\\s+crime|moyens\\s+de\\s+paiement",
  "reporting": "accounting\\s*(?:and|&)\\s*reporting|(?:financial|regulatory|group|statutory|management|esg)\\s+reporting|reporting\\s+(?:and|&)\\s+controls|\\breporting\\b.*\\b(?:ifrs|finance|financial)\\b",
  "generic_finance_head": "\\b(?:cfo|chief\\s+financial|head\\s+of\\s+finance|finance\\s+(?:manager|director|lead)|director(?:a)?\\s+financier|directeur\\s+financier|finanzleiter|leiter\\s+finanzen)",
  "admin_compound": "administrativ|administratie|administraci[oó]n|amministrativ|verwaltung|office\\s+(?:assistant|manager)|segreter|back[\\s-]?office|backoffice",
  "erp_it": "\\berp\\b|sap\\s+(?:fi|co|fico|mm|sd|s/4)\\b|consult\\w*\\s+sap|sap\\s+consult|finance\\s+systems|administrateur\\s+sap|sap\\s+finance|systems?\\s+(?:analyst|specialist|administrator)",
  "it_audit": "\\bit[-\\s]?audit|audit\\s+(?:it|informatique)|auditor\\s+it\\b|\\bgrc\\b",
  "media_buyer": "media\\s+buyer|buyer\\s+(?:media|fashion)|fashion\\s+buyer|visual\\s+merch",
  "executive_assistant": "executive\\s+assistant|personal\\s+assistant|asistente\\s+de\\s+direcci|assistant(?:e)?\\s+de\\s+direction|secretar\\w+\\s+de\\s+direcci|\\bea\\s+to\\b",
  "key_account": "key\\s+account|account\\s+(?:executive|manager|director|representative)|business\\s+develop|agente\\s+comercial",
  "customer_service": "customer\\s+(?:service|support|success|care)|atenci[oó]n\\s+al\\s+cliente|servicio\\s+al\\s+cliente|call\\s+cent|conseiller(?:e|\\(\\w+\\))?\\s+(?:client|banque|en\\s+gestion)|relationship\\s+manager|chargé\\s+de\\s+service",
  "branch": "directeur\\s+d['’]agence|responsable\\s+d['’]agence|bank\\s+branch|oficina\\s+bancaria|director\\s+de\\s+oficina",
  "quality_or_energy_audit": "auditor(?:\\s+de|\\s+of)?\\s+calidad|quality\\s+audit|energy\\s+audit|audit\\s+(?:energ|qualit)|milieumeting|auditeur\\s+energie|iso\\s*\\d{4,5}",
